# 智谱开放平台 API Key（必填）: https://open.bigmodel.cn/usercenter/apikeys
GLM_API_KEY=

# 主模型（默认 glm-4.6v-flash，视觉多模态）
# GLM_MODEL=glm-4.6v-flash

# 纯文本调用的备用模型链：主模型限流/不可用时按顺序尝试
# GLM_FALLBACK_MODELS=glm-4.5-flash,glm-4-flash

# 图像调用的备用模型链（必须支持视觉）
# GLM_VISION_FALLBACK_MODELS=glm-4v-flash

# 单个模型针对 429/1305/5xx 的重试次数，默认 2（退避 2s/4s）
# GLM_RETRIES=2

# 以下均为可选，留空即用默认值
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_API_URL=
# GLM_TIMEOUT_MS=180000
# GLM_MAX_TOKENS=4096
# GLM_IMAGE_ROOT=D:\pics
